#!/usr/bin/env node

const fs = require("node:fs");
const path = require("node:path");
const core = require("../src/foreman");
const { HerdrAdapter, HerdrCliTransport } = require("../src/herdr");
const { PaseoAdapter } = require("../src/paseo");
const paseoRouting = require("../src/paseo-routing");
const { installShellEnv } = require("../src/shell-env");

function die(message) { process.stderr.write(`foreman: ${message}\n`); process.exitCode = 2; }
function arg(name, fallback) {
  const index = process.argv.indexOf(name);
  return index >= 0 && process.argv[index + 1] !== undefined && !String(process.argv[index + 1]).startsWith("--") ? process.argv[index + 1] : fallback;
}
function flag(name) { return process.argv.includes(name); }
function args(name) {
  const values = [];
  for (let index = 2; index < process.argv.length; index += 1) {
    if (process.argv[index] === name && process.argv[index + 1] !== undefined && !String(process.argv[index + 1]).startsWith("--")) values.push(process.argv[++index]);
  }
  return values;
}
function roots() { return core.resolveRoots({ foremanRoot: process.env.FOREMAN_ROOT || process.cwd(), foremanHome: process.env.FOREMAN_HOME || process.env.FOREMAN_ROOT || process.cwd() }); }
function selectedBackend() {
  const backend = String(process.env.FOREMAN_BACKEND || "herdr").trim().toLowerCase();
  if (!["herdr", "paseo"].includes(backend)) throw new Error(`Unsupported FOREMAN_BACKEND: ${backend || "(empty)"}; expected herdr or paseo`);
  return backend;
}
function runtimeAdapter(backend = selectedBackend()) {
  if (backend === "paseo") return new PaseoAdapter();
  return new HerdrAdapter({ transport: new HerdrCliTransport({ command: process.env.FOREMAN_HERDR_COMMAND || "herdr" }) });
}
function sessionBackend() {
  if (process.env.FOREMAN_BACKEND) return selectedBackend();
  if (process.env.HERDR_ENV === "1") return "herdr";
  try {
    const taskRoot = path.join(roots().foremanHome, "data", "tasks");
    if (!fs.existsSync(taskRoot)) return null;
    const active = core.listTasks({ roots: roots() }).filter((meta) => !["accepted", "cleaned", "review-ready"].includes(meta.status));
    const backends = new Set(active.map((meta) => meta.backend || "herdr"));
    return backends.size === 1 ? [...backends][0] : null;
  } catch (_) {
    return null;
  }
}
function assertSelectedTaskBackend(taskId) {
  const meta = core.reconstructTask({ roots: roots(), taskId }).meta;
  const taskBackend = meta.backend || "herdr";
  if (taskBackend !== selectedBackend()) throw new Error(`Task backend is ${taskBackend}; use bin/foreman-${taskBackend} for this operation`);
  return meta;
}
function readStdin() {
  if (process.stdin.isTTY) return "";
  try { return fs.readFileSync(0, "utf8"); } catch (_) { return ""; }
}
function hookPayload() {
  try { return JSON.parse(readStdin() || "{}"); } catch (_) { return {}; }
}
function warnResourceConflicts(meta) {
  for (const conflict of meta?.resourceLease?.conflicts || []) {
    process.stderr.write(`foreman: warning: ${conflict.requested.key} (${conflict.requested.mode}) overlaps ${conflict.held.key} (${conflict.held.mode}) held by ${conflict.taskId} @${conflict.owner}\n`);
  }
}
function output(value) {
  if (typeof value === "string") { process.stdout.write(value.endsWith("\n") ? value : `${value}\n`); return; }
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}
function briefText() {
  const briefFile = arg("--brief-file");
  return briefFile ? fs.readFileSync(path.resolve(briefFile), "utf8") : arg("--brief");
}
function originalText() {
  const originalFile = arg("--original-file");
  return originalFile ? fs.readFileSync(path.resolve(originalFile), "utf8") : arg("--original");
}
function notesText() {
  const notesFile = arg("--notes-file");
  return notesFile ? fs.readFileSync(path.resolve(notesFile), "utf8") : arg("--notes");
}
// Each --image is a staged image ID from `image stage` or an image file path; none means undefined.
function imageSources(home) {
  const values = args("--image");
  return values.length ? core.resolveImageArgs({ roots: home, values }) : undefined;
}
function resourceClaims() {
  const raw = arg("--resources");
  if (raw === undefined) return undefined;
  const parsed = JSON.parse(raw);
  if (!Array.isArray(parsed)) throw new Error("resources must be a JSON array");
  return parsed;
}

const usage = [
  "usage:",
  "  init [--home PATH]",
  "  routing init",
  "  routing show",
  "  routing route --task ID",
  "  profiles sync [--dry-run]   (Paseo: sync repo-owned profiles into the selected Paseo home)",
  "  project register --id ID --root PATH [--name NAME]",
  "  image stage [--transcript FILE]   (copy the images of the user's latest message into the Foreman inbox; prints their IDs)",
  "  task create --project ID (--brief TEXT|--brief-file FILE) [--original TEXT|--original-file FILE] [--notes TEXT|--notes-file FILE] [--type ship|scout] [--dependency ID] [--image ID|FILE]...",
  "  task list [--project ID] [--json]",
  "  task confirm --task ID --profile NAME   (the human's choice of worker profile, required before dispatch)",
  "  task dispatch --task ID [--owner OWNER] [--workspace PATH] [--resources JSON] [--reuse-endpoint ENDPOINT]",
  "  task schedule [--owner OWNER] [--max N] [--project-limit ID=N]",
  "  task collect   (Paseo: collect finished-turn reports from assigned agents)",
  "  task promote --task ID [--brief TEXT|--brief-file FILE] [--original TEXT|--original-file FILE] [--dependency ID]",
  "  task adopt --worker NAME (--task ID|--brief TEXT|--brief-file FILE) [--original TEXT|--original-file FILE] [--project ID] [--type ship|scout]",
  "  task recover --task ID [--owner OWNER]",
  "  task accept --task ID",
  "  task discard --task ID      (untouched queued task, or worker confirmed dead or missing)",
  "  task brief --task ID (--text TEXT|--text-file FILE) [--image ID|FILE]...   (replace the brief of a task that has no worker yet; --image replaces round one's images)",
  "  task continue --task ID (--text TEXT|--text-file FILE) (--original TEXT|--original-file FILE) [--type ship|scout] [--resources JSON] [--interrupt] [--with-original] [--image ID|FILE]...",
  "  task reassign --task ID [--profile NAME] [--owner OWNER] [--text TEXT|--text-file FILE --original TEXT|--original-file FILE [--image ID|FILE]...] [--type ship|scout] [--resources JSON]",
  "  task message --task ID (--text TEXT|--text-file FILE) [--image ID|FILE]...",
  "  decision create --task ID --finding TEXT --why TEXT --option A --option B [--impact TEXT] [--evidence TEXT] [--recommendation TEXT]",
  "  decision answer --task ID --decision ID --response TEXT [--image ID|FILE]...",
  "  decision deliver --task ID --decision ID",
  "  status [--project ID] [--json]",
  "  report --status done|blocked|progress [--summary TEXT|--summary-file FILE]   (worker; summary defaults to stdin)",
  "  worker hook      (coding-agent stop hook; reads the hook payload from stdin)",
  "  session context  (Foreman session prompt hook; reads the hook payload from stdin)",
].join("\n");

function main() {
  const command = process.argv[2];
  const action = process.argv[3];
  if (!command || command === "--help" || command === "-h" || command === "help") { output(usage); return; }
  selectedBackend();
  if (command === "init") {
    // The Foreman checkout that runs init becomes the root recorded in the shell startup file.
    const root = process.cwd();
    if (!fs.existsSync(path.join(root, "bin", "foreman"))) throw new Error(`init must run from the Foreman checkout; ${root} has no bin/foreman`);
    const home = core.resolveRoots({ foremanRoot: root, foremanHome: arg("--home", root) });
    const initialized = core.initHome(home);
    const routing = core.initRoutingConfig({ roots: home, backend: selectedBackend() });
    const shell = installShellEnv({ vars: { FOREMAN_ROOT: home.foremanRoot, FOREMAN_HOME: home.foremanHome } });
    output({ ...initialized, backend: selectedBackend(), routingConfig: routing.file, shellEnv: { file: shell.file, shell: shell.shell, changed: shell.changed } });
    return;
  }
  if (command === "worker" && action === "hook") {
    // A stop hook must never break the coding agent, so every failure ends silently.
    try {
      if (selectedBackend() !== "herdr" || !process.env.FOREMAN_ROOT || !process.env.HERDR_PANE_ID) return;
      if (!fs.existsSync(path.join(process.env.FOREMAN_HOME || process.env.FOREMAN_ROOT, "data", "tasks"))) return;
      const decision = core.workerStopHook({ roots: roots(), paneId: process.env.HERDR_PANE_ID, payload: hookPayload() });
      if (decision) process.stdout.write(`${JSON.stringify(decision)}\n`);
    } catch (error) { process.stderr.write(`foreman worker hook: ${error.message}\n`); }
    return;
  }
  if (command === "session" && action === "context") {
    try {
      const payload = hookPayload();
      const backend = sessionBackend();
      const adapter = backend ? runtimeAdapter(backend) : null;
      const context = core.sessionContext({ roots: roots(), adapter, prompt: payload.prompt || "", cwd: payload.cwd, transcriptPath: payload.transcript_path, sessionId: payload.session_id });
      // Claude Code and Codex both read prompt context from this JSON shape.
      if (context) process.stdout.write(`${JSON.stringify({ hookSpecificOutput: { hookEventName: "UserPromptSubmit", additionalContext: context } })}\n`);
    } catch (error) { process.stderr.write(`foreman session context: ${error.message}\n`); }
    return;
  }
  if (command === "report") {
    if (selectedBackend() !== "herdr") throw new Error("Paseo workers report by returning the required JSON response; Foreman collects it with task collect");
    if (!process.env.FOREMAN_ROOT) throw new Error("FOREMAN_ROOT is not set; run bin/foreman init in the Foreman checkout");
    if (!process.env.HERDR_PANE_ID) throw new Error("HERDR_PANE_ID is not set; only a Foreman worker pane can report");
    const summaryFile = arg("--summary-file");
    const summary = summaryFile ? fs.readFileSync(path.resolve(summaryFile), "utf8") : (arg("--summary") ?? readStdin());
    output(core.recordReport({ roots: roots(), paneId: process.env.HERDR_PANE_ID, status: arg("--status"), summary }));
    return;
  }
  const home = roots();
  if (command === "profiles" && action === "sync") {
    if (selectedBackend() !== "paseo") throw new Error("Profile sync is available only through bin/foreman-paseo");
    output(paseoRouting.syncPaseoProfiles({ foremanRoot: home.foremanRoot, dryRun: flag("--dry-run") }));
    return;
  }
  if (command === "image" && action === "stage") {
    const transcript = arg("--transcript");
    output(core.stageImages({ roots: home, transcriptPath: transcript ? path.resolve(transcript) : undefined }));
    return;
  }
  if (command === "routing" && action === "init") { output(core.initRoutingConfig({ roots: home, backend: selectedBackend() })); return; }
  if (command === "routing" && action === "show") { output(core.initRoutingConfig({ roots: home, backend: selectedBackend() }).config); return; }
  if (command === "routing" && action === "route") {
    assertSelectedTaskBackend(arg("--task"));
    output(core.routeTask({ roots: home, taskId: arg("--task") }));
    return;
  }
  if (command === "project" && action === "register") {
    output(core.registerProject({ roots: home, id: arg("--id"), name: arg("--name", arg("--id")), root: arg("--root") }));
    return;
  }
  if (command === "task" && action === "create") {
    core.initRoutingConfig({ roots: home, backend: selectedBackend() });
    output(core.createTask({ roots: home, projectId: arg("--project"), brief: briefText(), original: originalText(), notes: notesText(), type: arg("--type", "ship"), dependencies: args("--dependency"), backend: selectedBackend(), images: imageSources(home) }));
    return;
  }
  if (command === "task" && action === "list") {
    const tasks = core.listTasks({ roots: home, projectId: arg("--project") }).map((meta) => ({ taskId: meta.taskId, meta, state: meta.status, issues: [] }));
    output(flag("--json") ? tasks.map((item) => item.meta) : core.renderUserReport({ tasks }, home));
    return;
  }
  if (command === "task" && action === "confirm") { assertSelectedTaskBackend(arg("--task")); output(core.confirmTaskProfile({ roots: home, taskId: arg("--task"), profile: arg("--profile") })); return; }
  if (command === "task" && action === "collect") {
    if (selectedBackend() !== "paseo") throw new Error("Paseo report collection is available only through bin/foreman-paseo");
    output(core.collectPaseoReports({ roots: home, adapter: runtimeAdapter() }));
    return;
  }
  if (command === "task" && action === "promote") {
    assertSelectedTaskBackend(arg("--task"));
    output(core.promoteScout({ roots: home, taskId: arg("--task"), brief: briefText(), original: originalText(), dependencies: args("--dependency") }));
    return;
  }
  if (command === "task" && action === "dispatch") {
    // A human dispatch proceeds past held leases; the overlaps are reported as a warning.
    const result = core.assignTask({ roots: home, taskId: arg("--task"), owner: arg("--owner"), adapter: runtimeAdapter(), workspacePath: arg("--workspace"), resources: resourceClaims(), reuseEndpoint: arg("--reuse-endpoint"), allowResourceConflicts: true });
    warnResourceConflicts(result);
    output(result);
    return;
  }
  if (command === "task" && action === "schedule") {
    const projectLimits = {};
    for (const entry of args("--project-limit")) {
      const splitAt = entry.indexOf("=");
      if (splitAt <= 0) throw new Error(`Invalid project limit: ${entry}`);
      projectLimits[entry.slice(0, splitAt)] = Number(entry.slice(splitAt + 1));
    }
    const max = arg("--max");
    const owner = arg("--owner");
    const result = core.dispatchReadyTasks({ roots: home, adapter: runtimeAdapter(), ownerForTask: owner ? () => owner : undefined, maxConcurrency: max === undefined ? Infinity : Number(max), projectLimits });
    output(result);
    return;
  }
  if (command === "task" && action === "adopt") {
    const result = core.adoptExistingWorker({ roots: home, adapter: runtimeAdapter(), worker: arg("--worker"), taskId: arg("--task"), brief: briefText(), original: originalText(), projectId: arg("--project"), type: arg("--type", "ship"), explicit: true });
    warnResourceConflicts(result);
    output(result);
    return;
  }
  if (command === "task" && action === "recover") {
    assertSelectedTaskBackend(arg("--task"));
    const result = core.recoverDeadWorker({ roots: home, taskId: arg("--task"), owner: arg("--owner"), adapter: runtimeAdapter() });
    warnResourceConflicts(result);
    output(result);
    return;
  }
  if (command === "task" && action === "accept") { assertSelectedTaskBackend(arg("--task")); output(core.acceptTask({ roots: home, taskId: arg("--task"), adapter: runtimeAdapter() })); return; }
  if (command === "task" && action === "discard") { assertSelectedTaskBackend(arg("--task")); output(core.discardTask({ roots: home, taskId: arg("--task"), adapter: runtimeAdapter() })); return; }
  if (command === "task" && action === "brief") {
    assertSelectedTaskBackend(arg("--task"));
    const textFile = arg("--text-file");
    const text = textFile ? fs.readFileSync(path.resolve(textFile), "utf8") : arg("--text");
    if (!text) throw new Error("task brief requires --text or --text-file");
    output(core.replaceTaskBrief({ roots: home, taskId: arg("--task"), text, images: imageSources(home) }));
    return;
  }
  if (command === "task" && action === "continue") {
    assertSelectedTaskBackend(arg("--task"));
    const textFile = arg("--text-file");
    const text = textFile ? fs.readFileSync(path.resolve(textFile), "utf8") : arg("--text");
    if (!text) throw new Error("task continue requires --text or --text-file");
    const original = originalText();
    if (!original) throw new Error("task continue requires --original or --original-file");
    const result = core.continueTask({ roots: home, taskId: arg("--task"), text, original, type: arg("--type"), resources: resourceClaims(), interrupt: flag("--interrupt"), withOriginal: flag("--with-original"), adapter: runtimeAdapter(), images: imageSources(home) });
    warnResourceConflicts(result.task);
    output(result);
    return;
  }
  if (command === "task" && action === "reassign") {
    assertSelectedTaskBackend(arg("--task"));
    const textFile = arg("--text-file");
    const result = core.reassignWorker({ roots: home, taskId: arg("--task"), adapter: runtimeAdapter(), profile: arg("--profile"), owner: arg("--owner"), text: textFile ? fs.readFileSync(path.resolve(textFile), "utf8") : arg("--text"), original: originalText(), type: arg("--type"), resources: resourceClaims(), images: imageSources(home) });
    warnResourceConflicts(result);
    output(result);
    return;
  }
  if (command === "task" && action === "message") {
    assertSelectedTaskBackend(arg("--task"));
    const textFile = arg("--text-file");
    const text = textFile ? fs.readFileSync(path.resolve(textFile), "utf8") : arg("--text");
    if (!text) throw new Error("task message requires --text or --text-file");
    output(core.sendWorkerMessage({ roots: home, taskId: arg("--task"), payload: { request: text }, adapter: runtimeAdapter(), images: imageSources(home) }));
    return;
  }
  if (command === "decision" && action === "create") {
    assertSelectedTaskBackend(arg("--task"));
    output(core.createDecision({ roots: home, taskId: arg("--task"), finding: arg("--finding"), why: arg("--why"), options: args("--option"), impact: arg("--impact"), evidence: arg("--evidence"), recommendation: arg("--recommendation") }));
    return;
  }
  if (command === "decision" && action === "answer") {
    assertSelectedTaskBackend(arg("--task"));
    output(core.answerDecision({ roots: home, taskId: arg("--task"), decisionId: arg("--decision"), response: arg("--response"), images: imageSources(home) }));
    return;
  }
  if (command === "decision" && action === "deliver") {
    assertSelectedTaskBackend(arg("--task"));
    output(core.deliverDecision({ roots: home, taskId: arg("--task"), decisionId: arg("--decision"), adapter: runtimeAdapter() }));
    return;
  }
  if (command === "status") {
    const adapter = runtimeAdapter();
    const status = arg("--project") ? core.projectStatus({ roots: home, projectId: arg("--project"), adapter }) : core.fleetStatus({ roots: home, adapter });
    output(flag("--json") ? status : core.renderUserReport(status, home));
    return;
  }
  die(usage);
}

try { main(); } catch (error) { die(error.message); }
